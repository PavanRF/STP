# Browser-safe Supabase project settings (publishable/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side Supabase settings
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Only needed for server-only administrative operations. NEVER use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional cron endpoint secret if you add scheduled server endpoints.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CRON_SECRET_PREVIOUS=

# Reserved for a future server-side Gemini assistant integration.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
